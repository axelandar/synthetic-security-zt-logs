{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": { "type": "string" },
    "location": { "type": "string" },
    "dcrName": { "type": "string", "defaultValue": "dcr-synthetic-msft-logs" },
    "families": { "type": "array" },
    "streamDeclarations": { "type": "object" },
    "dataFlows": { "type": "array" },
    "publisherObjectId": { "type": "string" },
    "publisherPrincipalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": ["User", "ServicePrincipal"]
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), parameters('families')[copyIndex()].tableName)]",
      "copy": { "name": "syntheticTables", "count": "[length(parameters('families'))]" },
      "properties": {
        "plan": "Analytics",
        "schema": {
          "name": "[parameters('families')[copyIndex()].tableName]",
          "columns": "[parameters('families')[copyIndex()].columns]"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2024-03-11",
      "name": "[parameters('dcrName')]",
      "location": "[parameters('location')]",
      "kind": "Direct",
      "tags": { "purpose": "synthetic-log-testing" },
      "dependsOn": ["syntheticTables"],
      "properties": {
        "streamDeclarations": "[parameters('streamDeclarations')]",
        "destinations": {
          "logAnalytics": [
            {
              "name": "syntheticWorkspace",
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
            }
          ]
        },
        "dataFlows": "[parameters('dataFlows')]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), parameters('publisherObjectId'), 'synthetic-publisher')]",
      "scope": "[format('Microsoft.Insights/dataCollectionRules/{0}', parameters('dcrName'))]",
      "dependsOn": ["[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName'))]"],
      "properties": {
        "principalId": "[parameters('publisherObjectId')]",
        "principalType": "[parameters('publisherPrincipalType')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]"
      }
    }
  ],
  "outputs": {
    "dcrResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName'))]"
    },
    "dcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2024-03-11').immutableId]"
    },
    "ingestionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2024-03-11').endpoints.logsIngestion]"
    }
  }
}
