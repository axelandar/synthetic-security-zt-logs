{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "automationAccountName": { "type": "string" },
    "startTime": { "type": "string" },
    "timeZone": { "type": "string", "defaultValue": "America/New_York" }
  },
  "resources": [
    {
      "type": "Microsoft.Automation/automationAccounts/schedules",
      "apiVersion": "2024-10-23",
      "name": "[format('{0}/Daily-0900-Eastern', parameters('automationAccountName'))]",
      "properties": {
        "description": "Daily at 09:00 America/New_York, observing daylight saving time.",
        "frequency": "Day",
        "interval": 1,
        "startTime": "[parameters('startTime')]",
        "timeZone": "[parameters('timeZone')]"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/jobSchedules",
      "apiVersion": "2024-10-23",
      "name": "[format('{0}/{1}', parameters('automationAccountName'), guid(resourceGroup().id, parameters('automationAccountName'), 'daily-zero-trust-0900'))]",
      "dependsOn": ["[resourceId('Microsoft.Automation/automationAccounts/schedules', parameters('automationAccountName'), 'Daily-0900-Eastern')]"],
      "properties": {
        "runOn": "",
        "runbook": { "name": "Send-DailyZeroTrustLogs" },
        "schedule": { "name": "Daily-0900-Eastern" },
        "parameters": {}
      }
    }
  ]
}
